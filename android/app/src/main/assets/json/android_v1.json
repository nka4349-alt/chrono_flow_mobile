{
  "settings": {
    "app_name": "ChronoFlow",
    "base_url": "https://chrono-flow-mvp.onrender.com",
    "entry_path": "/"
  },
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "/login$",
        "/signup$"
      ],
      "properties": {
        "context": "default",
        "presentation": "replace_root",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false
      }
    }
  ]
}
